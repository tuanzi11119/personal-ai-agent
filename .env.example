# ---------------------------------------------------------------------------
# Personal AI Agent Platform - environment template
#
# Local dev:      copy to backend/.env   (FastAPI reads backend/.env)
# Docker compose: copy to .env           (compose reads the project-root .env)
# Never commit a real .env or real API keys.
# ---------------------------------------------------------------------------

# === Docker Compose deployment (ignored by the app itself) =================
# REQUIRED for docker compose: database password. Use hex to keep it URL-safe:
#   openssl rand -hex 16
POSTGRES_PASSWORD=change-me-run-openssl-rand-hex-16
# The public origin browsers will use. Feeds CORS and (after HTTPS) the cookie
# domain checks. Example: https://twin.example.com
PUBLIC_ORIGIN=http://localhost:3000
# Build-time package mirrors (used by docker compose build only). Hosts in
# mainland China should point these at local mirrors; elsewhere leave them as is.
PIP_INDEX_URL=https://pypi.org/simple
NPM_REGISTRY=https://registry.npmjs.org
# Host port that publishes the frontend container. Use 80 for an IP-only deploy
# on a cloud host whose firewall already opens 80/443 (Tencent Lighthouse does
# not open 3000 by default). With a reverse proxy in front, keep 3000.
HTTP_PORT=3000

APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO

# Signs JWTs and derives the AES-key used to encrypt user API keys.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# true only when the site is served over HTTPS (nginx + certbot). With
# COOKIE_SECURE=true on plain http://IP the login cookie is dropped by the browser.
COOKIE_SECURE=false

# SQLite (default, no Docker required)
DATABASE_URL=sqlite:///./storage/app.db
# PostgreSQL + pgvector (docker compose)
# DATABASE_URL=postgresql+psycopg://pai:pai_password@localhost:5432/pai

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

STORAGE_DIR=./storage
MAX_UPLOAD_MB=10
ALLOWED_EXTENSIONS=.pdf,.txt,.md,.markdown
CHUNK_SIZE=800
CHUNK_OVERLAP=150

DEFAULT_TOP_K=5
MAX_TOP_K=12
# Cosine cut-off for real embedding models (below it the agent refuses to answer).
MIN_RETRIEVAL_SCORE=0.15
# The offline mock embedder scores lower; it uses its own cut-off.
MOCK_MIN_RETRIEVAL_SCORE=0.08
MAX_CONTEXT_CHARS=6000
MAX_HISTORY_MESSAGES=12
# When no chunk clears the similarity cut-off, a knowledge base with at most this many
# chunks is handed to the model in full (best-effort order) instead of refusing blindly.
# Guards against phrasing mismatches such as "毕业于哪里" vs "研究生院校：XX大学". 0 disables it.
FALLBACK_CONTEXT_MAX_CHUNKS=20

MAX_USER_MESSAGE_CHARS=4000
MAX_ANSWER_TOKENS=800
PUBLIC_RATE_LIMIT_PER_MINUTE=20
AUTH_RATE_LIMIT_PER_MINUTE=12

# --- Chat model -------------------------------------------------------------
# auto: use openai_compatible when PLATFORM_LLM_API_KEY is set, else mock
LLM_PROVIDER=auto
PLATFORM_LLM_BASE_URL=https://api.openai.com/v1
PLATFORM_LLM_API_KEY=
PLATFORM_LLM_MODEL=gpt-4o-mini
PLATFORM_LLM_TEMPERATURE=0.3
PLATFORM_LLM_MAX_TOKENS=800
LLM_TIMEOUT_SECONDS=60

# --- Embeddings -------------------------------------------------------------
# Dimension MUST match the pgvector column. Changing it requires re-indexing.
EMBEDDING_PROVIDER=auto
PLATFORM_EMBEDDING_BASE_URL=https://api.openai.com/v1
PLATFORM_EMBEDDING_API_KEY=
PLATFORM_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=384
EMBEDDING_TIMEOUT_SECONDS=60
